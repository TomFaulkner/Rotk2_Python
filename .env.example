# ROTK2 Battle System Configuration
# Copy this file to .env and modify values as needed

# UI Mode
# Options: classic (DOS CGA-style) | modern (Steam Deck optimized)
ROTK2_UI_MODE=modern

# Rice Depletion Mode
# Options: force_retreat (original game behavior) | desertion (alternative)
RICE_DEPLETION_MODE=force_retreat

# Rice consumption rate (troops per rice unit)
RICE_CONSUMPTION_RATE=250

# Desertion percentage when rice runs out (only applies to desertion mode)
DESERTION_PERCENTAGE=0.15

# Maximum battle duration
MAX_BATTLE_DAYS=30

# Maximum units on battlefield per side
MAX_UNITS_ON_MAP=10

# Debug mode
DEBUG_MODE=false

# Enable battle event logging
LOG_BATTLE_EVENTS=true